{
  "name": "chain-of-custody",
  "version": "0.1.0",
  "private": true,
  "description": "Chain of Custody: Blackwater Evidence. Domain core, policies, harness and planning.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kcasko/chain-of-custody.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs core/test/*.test.ts app/test/*.test.ts adapters/aws/test/*.test.ts infra/test/*.test.ts",
    "test:e2e": "playwright test",
    "collaborate": "node scripts/collaborate.cjs",
    "verify:conversation": "node scripts/verify-conversation.cjs",
    "harness:stage-b": "node harness/run-stage-b.cjs",
    "harness:stage-b-core": "node harness/run-stage-b-core.mts",
    "agent:ask": "node harness/ask-agent.mts",
    "agent:stress": "node harness/run-stress-test.mts",
    "typecheck": "tsc -p core && tsc -p app && tsc -p app/e2e && tsc -p adapters/aws && tsc -p infra",
    "cdk:synth": "cd infra && cdk synth --quiet",
    "fixtures:check": "node core/tools/fixture-manifest.ts",
    "demo": "node app/src/main.ts",
    "verify:export": "node core/tools/verify-export.ts"
  },
  "devDependencies": {
    "@cedar-policy/cedar-wasm": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "aws-cdk": "2.1147.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1161.0",
    "@aws-sdk/client-dynamodb": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0"
  }
}

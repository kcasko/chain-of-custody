{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheOperatorAdminRole",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::${ACCOUNT_ID}:root" },
      "Action": "sts:AssumeRole",
      "Condition": { "ArnLike": { "aws:PrincipalArn": "${ADMIN_ROLE_ARN}" } }
    }
  ]
}
